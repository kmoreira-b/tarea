spring.application.name=tarea

spring.datasource.url=jdbc:postgresql://localhost:5432/postgres
spring.datasource.username=postgres
spring.datasource.password=postgres

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# JWT
# jwt.secret debe ser una cadena en Base64 que decodifique a 32 bytes o mas (256 bits) para HS256.
# Puede usar el valor de ejemplo o generar uno nuevo (ver README).
jwt.secret=Zm9zdGVyVGFyZWFDcnVkU3VwZXJTZWNyZXRLZXkxMjM0NTY3ODkwQUJDREVG
jwt.expiration=86400000
